{
  "name": "roxy-pinball",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icon": "node tools/gen-icon.mjs",
    "table": "node --experimental-strip-types --import ./tools/resolve-ts.mjs tools/preview-table.mjs",
    "sim": "node --experimental-strip-types --import ./tools/resolve-ts.mjs tools/sim.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.171.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "three": "^0.171.0"
  }
}
